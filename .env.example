# Supabase project (Dashboard → Project Settings → API). The publishable key is
# safe to expose in the browser; never put the secret/service-role key here.
# For local dev, `npx supabase start` prints both values.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Public URL of the deployed site, including the base path, no trailing slash.
# Used in printed locker QR codes and social-preview tags. Optional locally.
VITE_PUBLIC_SITE_URL="https://omriper.github.io/biu-makerspace-website"

# Path the site is served from: "/" for a custom domain or local dev,
# "/biu-makerspace-website/" for the GitHub Pages project URL.
VITE_BASE_PATH="/"
